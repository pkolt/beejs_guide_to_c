.DEFAULT_GOAL := help

.PHONY: all clean pristine help

all:
	$(MAKE) -C src all

clean:
	$(MAKE) -C src clean

pristine:
	$(MAKE) -C src pristine

help:
	@echo "    all        build the Russian translation"
	@echo "    clean      remove temporary build products"
	@echo "    pristine   remove all build products"
